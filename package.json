{
  "name": "kisansetu",
  "version": "1.0.0",
  "description": "KisanSetu - Common India-Wide Agricultural Procurement Scheduling & Queue Management Platform (SIH 2026 Problem ID 26032)",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "prisma generate --schema=server/prisma/schema.prisma && cd client && npm install --no-audit --no-fund && npm run build",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "db:seed": "cd server && npm run db:seed",
    "db:push": "cd server && npm run db:push",
    "db:generate": "cd server && npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "sih2026",
    "agritech",
    "procurement",
    "queue-management",
    "farmer-welfare"
  ],
  "author": "SIH 2026 Team",
  "license": "MIT"
}
